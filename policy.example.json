{
  "tabsIdleHours": 2,
  "tabs": [
    "Mi-Proyecto",
    "~/trabajo/web"
  ],
  "exclude": [
    "carpeta-que-no-quiero-ver"
  ],
  "rules": [
    {
      "path": "~/proyectos/personal",
      "free": true
    },
    {
      "under": "~/trabajo",
      "protected": [
        "main",
        "release"
      ],
      "base": "develop"
    },
    {
      "under": "~/cliente",
      "bases": "~/cliente/bases.json"
    }
  ],
  "commands": [
    {
      "label": "Mergear",
      "run": "git mi-merge",
      "warn": true
    },
    {
      "label": "Continuar merge",
      "run": "git mi-merge --continue",
      "when": "merging"
    }
  ],
  "tickets": [
    {
      "under": "~/trabajo",
      "dir": "~/trabajo/harness/tickets"
    }
  ],
  "scan": {
    "under": "~/trabajo",
    "run": "~/bin/mi-scanner"
  },
  "worktrees": {
    "under": "~/trabajo",
    "create": "git mi-worktree {repo} {branch}",
    "remove": "git mi-worktree -d {repo} {branch}"
  }
}
